{
  "realm": "lab",
  "enabled": true,
  "accessTokenLifespan": 1800,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "lab-api",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "access.token.signed.response.alg": "RS256"
