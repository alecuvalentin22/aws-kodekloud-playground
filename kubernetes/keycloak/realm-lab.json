      "emailVerified": true,
      "firstName": "Lab",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "labpassword",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-lab"
      ],
      "email": "labuser@lab.invalid",
      "requiredActions": []
    }
  ],
  "verifyEmail": false,
  "resetPasswordAllowed": false
