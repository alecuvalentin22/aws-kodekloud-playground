# SINGLE SOURCE OF TRUTH for every pinned version in this repo.
#
# Every install script sources this. Nothing pins a version inline any more,
# because the previous arrangement had the same component pinned in three
# places (a script default, an Argo CD Application, and a README) and they
# drifted apart within a week.
#
# Check for updates with:   ./scripts/check-versions.sh
#
# WHY PIN AT ALL, rather than track latest?
#
# A floating tag means the cluster can change without a commit, which quietly
# ends "git is the source of truth" -- the property the whole GitOps half of
# this repo exists to demonstrate. The cost is that pins go stale and stale
# means unpatched. check-versions.sh exists to make that cost visible and
# cheap to pay, which is the trade: pin deliberately, and diff against upstream
# on a schedule.
#
# In a real repo this file is what Renovate or Dependabot would raise PRs
# against.
#
# Verified against upstream 2026-09-02.

# --- GitOps controllers -----------------------------------------------------
ARGOCD_VERSION=v3.5.2                 # argoproj/argo-cd
FLUX_VERSION=2.9.5                    # fluxcd/flux2 -- also the FluxInstance pin
FLUXOP_VERSION=v0.59.0                # controlplaneio-fluxcd/flux-operator

# --- progressive delivery ---------------------------------------------------
ROLLOUTS_VERSION=v1.10.0              # argoproj/argo-rollouts
FLAGGER_CHART=1.45.0                  # flagger/flagger
LOADTESTER_CHART=0.39.0               # flagger/loadtester -- was unpinned, i.e.
                                      # floating, which is the worst of both

# --- gateway / ingress ------------------------------------------------------
NGINX_CHART=4.15.1                    # ingress-nginx/ingress-nginx (app 1.15.1)
APISIX_CHART=2.17.0                   # apisix/apisix (app 3.18.0)
AIC_CHART=1.3.0                       # apisix/apisix-ingress-controller (app 2.2.0)

# --- platform ---------------------------------------------------------------
KPS_VERSION=88.6.2                    # kube-prometheus-stack (app v0.93.1)
SEALED_CHART=2.19.3                   # sealed-secrets (app 0.39.1)

# --- workloads --------------------------------------------------------------
# 6.7.1 was EIGHT minor versions behind. Nothing forced it; it was simply the
# number first typed and then copied everywhere.
PODINFO_VERSION=6.15.0

# --- cluster ----------------------------------------------------------------
# Flux v2.9 requires Kubernetes >= 1.33, so 1.33 is a floor and not a
# preference. Raising it needs the whole stack re-verified.
CLUSTER_VERSION=1.33
ETCD_CHART=12.0.18                    # bitnami/etcd chart, app 3.6.4
ETCD_IMAGE_TAG=3.6.4-debian-12-r4     # from bitnamilegacy -- docker.io/bitnami/etcd
                                      # has NO tags since Bitnami went subscription-only
                                      # apisix chart's bundled bitnamilegacy:latest
