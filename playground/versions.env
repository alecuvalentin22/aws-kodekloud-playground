# Pins for the local playground. Everything shared with the EKS lab (Jenkins
# chart, BuildKit) comes from ../versions.env so the two cannot drift apart.
KIND_VERSION=v0.33.0                  # kubernetes-sigs/kind, released 2026-08-26
# One minor above EKS 1.33 (closest kind publishes) and within one minor of
# the agent pod's kubectl (alpine/k8s:1.33.x).
KIND_NODE_IMAGE=kindest/node:v1.34.11@sha256:44e222ee2132dab25ff87301682f89eb82c7880ea3a1bf543bfe9708fd08d67d
GITEA_IMAGE=gitea/gitea:1.27.3-rootless   # stands in for GitHub: repos, PRs, history
REGISTRY_IMAGE=registry:3.0.0             # stands in for ECR
