# Copy to inventory/hosts.ini and put your real IPs in.
# Works unchanged against Hetzner VMs, Multipass VMs, or bare metal.

[elastic]
es-01 ansible_host=10.0.0.11 elastic_node_roles="master,data"
es-02 ansible_host=10.0.0.12 elastic_node_roles="master,data"
es-03 ansible_host=10.0.0.13 elastic_node_roles="master,data"

[kibana]
es-01

[minio]
es-01

[postgres]
es-01

[k8s]
k3s-01 ansible_host=10.0.0.21

[all:vars]
ansible_user=root
ansible_python_interpreter=/usr/bin/python3
