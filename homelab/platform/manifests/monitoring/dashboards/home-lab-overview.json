    {
      "id": 10,
      "type": "table",
      "title": "Applications",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 14,
        "w": 10,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "argocd_app_info",
          "legendFormat": "",
          "refId": "A",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "health_status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Healthy": {
                        "color": "green",
                        "index": 0
                      },
                      "Progressing": {
                        "color": "orange",
                        "index": 1
                      },
                      "Degraded": {
                        "color": "red",
                        "index": 2
                      },
                      "Missing": {
                        "color": "red",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sync_status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Synced": {
                        "color": "green",
                        "index": 0
                      },
                      "OutOfSync": {
                        "color": "red",
                        "index": 1
                      },
                      "Unknown": {
                        "color": "orange",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "name",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "pod": true,
              "service": true,
              "dest_namespace": true,
              "dest_server": true,
              "operation": true,
              "repo": true,
              "autosync_enabled": true,
              "exported_namespace": true
            },
            "indexByName": {
              "name": 0,
              "project": 1,
              "health_status": 2,
              "sync_status": 3
            },
            "renameByName": {}
          }
        }
      ]
    },
