# Copy to homelab/inventory.ini (git-ignored). One line per home-lab PC.
#
# ansible_host is the Mac's ssh alias for the Ubuntu side (Host homelab-1-wsl
# in ~/.ssh/config.d/homelab): ssh config supplies the ProxyJump through the
# Windows sshd, port 2222, the homelab key and the PINNED host key
# (HostKeyAlias), so nothing about the tunnel is repeated here.
[homelab]
homelab-wsl ansible_host=homelab-1-wsl

[homelab:vars]
ansible_python_interpreter=/usr/bin/python3
playground_ssh_enable=true
playground_ssh_port=2222
