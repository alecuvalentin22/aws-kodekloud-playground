# The PC's address on the home LAN, and the LAN itself. The single record of
# "where the lab is": homelab/mac/readdress.sh reads the old values from here,
# rewrites every tracked file that names them, then updates this file.
# Change it only through that script (it is what keeps the repo consistent).
HOMELAB_LAN_IP=192.168.0.23
HOMELAB_LAN_CIDR=192.168.0.0/24
