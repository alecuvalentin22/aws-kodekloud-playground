# Managed by Ansible (roles/homelab, tasks/lan_ingress.yml). Do not edit.
# L4 / TLS passthrough: the RKE2 nodes' ingress-nginx hostPorts, plus homelab_lan_tcp_forwards.
global
    log stdout format raw local0
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

defaults
    log     global
    mode    tcp
    option  tcplog
    option  log-health-checks
    option  dontlognull
    timeout connect 5s
    timeout client  1h
    timeout server  1h
    timeout tunnel  1h

frontend lan_http
    bind 0.0.0.0:{{ homelab_lan_ingress_http_port }}
    default_backend rke2_http

frontend lan_https
    bind 0.0.0.0:{{ homelab_lan_ingress_https_port }}
    default_backend rke2_https

backend rke2_http
    balance leastconn
    default-server check inter {{ homelab_lan_ingress_check_inter }} fall {{ homelab_lan_ingress_check_fall }} rise {{ homelab_lan_ingress_check_rise }} on-marked-down shutdown-sessions
{% for vm in homelab_vms %}
    server {{ vm.name }} {{ vm.ip }}:{{ homelab_lan_ingress_backend_http_port }}
{% endfor %}

backend rke2_https
    balance leastconn
    default-server check inter {{ homelab_lan_ingress_check_inter }} fall {{ homelab_lan_ingress_check_fall }} rise {{ homelab_lan_ingress_check_rise }} on-marked-down shutdown-sessions
{% for vm in homelab_vms %}
    server {{ vm.name }} {{ vm.ip }}:{{ homelab_lan_ingress_backend_https_port }}
{% endfor %}

{% for f in homelab_lan_tcp_forwards %}
# {{ f.name }}: {{ f.bind | default('0.0.0.0') }}:{{ f.port }} -> {{ f.backends | join(',') }}:{{ f.backend_port }}
frontend fwd_{{ f.name }}
    bind {{ f.bind | default('0.0.0.0') }}:{{ f.port }} transparent
    default_backend fwd_{{ f.name }}

backend fwd_{{ f.name }}
    balance leastconn
    default-server check inter {{ homelab_lan_ingress_check_inter }} fall {{ homelab_lan_ingress_check_fall }} rise {{ homelab_lan_ingress_check_rise }} on-marked-down shutdown-sessions
{% for ip in f.backends %}
    server b{{ loop.index }} {{ ip }}:{{ f.backend_port }}
{% endfor %}

{% endfor %}
# Loopback only: curl -s 'http://127.0.0.1:{{ homelab_lan_ingress_stats_port }}/;csv' for UP/DOWN per backend.
frontend stats
    bind 127.0.0.1:{{ homelab_lan_ingress_stats_port }}
    mode http
    timeout client 10s
    http-request use-service prometheus-exporter if { path /metrics }
    stats enable
    stats uri /
    stats refresh 5s
