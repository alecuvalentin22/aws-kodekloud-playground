# Generated by playbooks/homelab-vms.yml -- do not edit; re-run it instead.
#
#   ansible-playbook -i homelab/generated/k8s.ini playbooks/rke2-cluster.yml
#     one multi-node RKE2 cluster from [rke2_servers] + [rke2_agents]
#   ansible-playbook -i homelab/generated/k8s.ini playbooks/k8s.yml --limit <vm>
#     the older single-node path, per host (k8s_distribution per host)

[k8s]
{% for vm in homelab_vms %}
{{ vm.name }} ansible_host={{ vm.ip }} k8s_distribution={{ vm.distribution }}
{% endfor %}

[rke2_servers]
{# Extra API-cert SANs (e.g. the PC's LAN IP) as a HOST-line var: INI host vars
   are parsed as Python literals, [group:vars] values stay strings. Persisting
   it here means re-running rke2-cluster.yml cannot silently drop the SAN. #}
{% for vm in homelab_vms if vm.role | default('') == 'server' %}
{{ vm.name }}{% if homelab_rke2_extra_sans | length > 0 %} rke2_cluster_extra_sans='{{ homelab_rke2_extra_sans | to_json }}'{% endif %}

{% endfor %}

[rke2_agents]
{% for vm in homelab_vms if vm.role | default('') == 'agent' %}
{{ vm.name }}
{% endfor %}

[rke2:children]
rke2_servers
rke2_agents

[all:vars]
ansible_user={{ homelab_vm_user }}
ansible_python_interpreter=/usr/bin/python3
# Mac -> Windows OpenSSH -> WSL sshd (127.0.0.1:2222) -> VM. Nothing opened
# to the LAN beyond the Windows SSH server.
# The home-lab key, and ONLY it: without IdentitiesOnly, ssh offers the agent's
# keys first and the VM's sshd closes the connection before it gets there.
ansible_ssh_private_key_file={{ homelab_vm_private_key }}
ansible_ssh_common_args='-o ProxyJump={{ homelab_proxy_jump }} -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new'
