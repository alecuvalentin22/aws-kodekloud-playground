#cloud-config
# Managed by Ansible (roles/homelab). Key-only login; passwordless sudo for
# Ansible's become, as on a cloud image.
users:
  - name: {{ homelab_vm_user }}
    shell: /bin/bash
    groups: [sudo]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    # NOT lock_passwd: true. That writes "!" into the password field, and this
    # sshd then refuses the account for keys too: "User lab not allowed because
    # account is locked" (homelab-1). "*" can never match a password, so the
    # account is key-only without being locked. ssh_pwauth: false below as well.
    lock_passwd: false
    hashed_passwd: "*"
    ssh_authorized_keys:
{% for k in homelab_vm_ssh_keys %}
      - {{ k }}
{% endfor %}
ssh_pwauth: false
packages: [openssh-server, python3, iptables]
